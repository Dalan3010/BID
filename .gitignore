# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# Committed: .env.example (template without secrets)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by `next dev` for AI agents; not part of the project
AGENTS.md

# agent tooling metadata; not part of the project
.atl/

# editor and OS noise
.vscode/
.idea/
*.swp
Thumbs.db

# local scratch
/tmp/
*.local

# Impeccable working artifacts.
#
# The design source is committed: PRODUCT.md, the comps, the surface brief and
# the build state. These are the intermediate files of one run — the measured
# spec, the scaffold, the crop-by-crop diff — and the tooling regenerates them,
# so they do not belong in the history.
apps/web/.impeccable/build/
apps/web/.impeccable/review/

# Playwright artifacts (apps/web e2e)
apps/web/test-results/
apps/web/playwright-report/
