# Environment variables
# Copy this file to `.env.local`. `.env.local` is git-ignored; this template
# never holds secrets.
#
# There is a single file, at the repository root: `apps/web/next.config.ts`
# loads it with `loadEnvConfig`, so a value is declared once.

# Base URL of the API the client talks to.
# Baked into the client bundle at build time, so it must be set before building.
NEXT_PUBLIC_API_URL=http://localhost:3001
