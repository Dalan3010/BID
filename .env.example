# Environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored; this template never holds secrets.
#
# There is a single file, at the repository root, shared by both applications.
# The API loads it through `tsx --env-file-if-exists` and the client through
# `Frontend/next.config.ts`, so a value is declared once.

# Database connection string (Postgres)
# Matches the container defined in `compose.yaml`.
DATABASE_URL=postgres://bid:bid@localhost:5432/bid

# Authentication
# `BETTER_AUTH_URL` is the API's own origin: the session cookie is issued there.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# The two processes
# `API_PORT` is where the API listens. `WEB_ORIGIN` is the exact origin the
# browser app is served from: it is the only origin the API answers CORS for and
# the only one Better Auth trusts.
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Baked into the client bundle at build time, so it must be set before building.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Links that carry a token in the server log
# A password-reset token is a bearer credential, so it is NOT written to the
# log by default: the link is logged with the token redacted. Set this to `1`
# only in local development, while there is no mail provider and the link has
# to be read from the console to be usable.
AUTH_LOG_SECRETS=0

# Cookies across two different domains
# On localhost the two ports are the same site (the site ignores the port), so
# the default `lax` is enough and the cookie travels. Set it to `none` when the
# API and the client live on different sites: the cookie then becomes
# `SameSite=None; Secure`, which requires HTTPS.
AUTH_COOKIE_SAMESITE=lax

# AI provider
# `rehearsal` replays scripted answers and needs no key: that is what makes the
# app demonstrable without a provider. `live` uses the Google model below.
COACH_PROVIDER=rehearsal
COACH_MODEL=gemini-2.5-flash-lite
EXTRACTOR_MODEL=gemini-2.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Model calls allowed per idea before the extraction announces the limit.
COACH_QUOTA=50

# Feature flag reserved for Phase 7. Today the demo is `COACH_PROVIDER=rehearsal`.
DEMO_MODE=false
