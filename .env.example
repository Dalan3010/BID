# Environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored; this template never holds secrets.

# Database connection string (Postgres)
DATABASE_URL=

# AI provider
# Only one provider is needed. Leave the rest empty.
AI_PROVIDER=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Feature flags
# When true, the app replays scripted coach responses instead of calling the
# model. Required for the live demo (see docs/especificacion-funcional.md, H).
DEMO_MODE=false
