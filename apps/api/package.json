{
  "name": "@bid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env.local src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env.local src/infrastructure/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env.local src/infrastructure/db/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@bid/core": "workspace:*",
    "@hono/node-server": "^1.19.4",
    "ai": "^7.0.159",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.2",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
